/* ===== RESET ===== */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* ===== BODY ===== */

body {
  font-family: "Poppins", sans-serif;
  background: #fffdf8;
  color: #333;
  line-height: 1.6;
}

/* ===== NAVBAR ===== */

nav {
  position: sticky;
  top: 0;
  z-index: 1000;

  display: flex;
  justify-content: space-between;
  align-items: center;

  padding: 1rem 8%;
  background: rgba(255, 255, 255, 0.95);

  backdrop-filter: blur(10px);
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
}

.logo {
  font-size: 2rem;
  font-weight: 700;
  color: #2d6a4f;
}

nav ul {
  display: flex;
  list-style: none;
  gap: 2rem;
}

nav a {
  text-decoration: none;
  color: #333;
  font-weight: 500;
  transition: 0.3s ease;
}

nav a:hover {
  color: #2d6a4f;
}

/* ===== HERO SECTION ===== */

.hero {
  min-height: 90vh;

  display: flex;
  align-items: center;
  justify-content: center;

  text-align: center;
  padding: 4rem 8%;

  background:
    linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)),
    url("https://images.unsplash.com/photo-1607006483225-4f58c4b3f4f2?q=80&w=1400&auto=format&fit=crop");

  background-size: cover;
  background-position: center;

  color: white;
}

.hero-content {
  max-width: 700px;
}

.hero h1 {
  font-size: clamp(3rem, 8vw, 5rem);
  margin-bottom: 1rem;
  line-height: 1.1;
}

.hero p {
  font-size: 1.2rem;
  margin-bottom: 2rem;
  opacity: 0.95;
}

/* ===== BUTTONS ===== */

.btn,
.buy-btn {
  display: inline-block;
  background: #2d6a4f;
  color: white;

  border: none;
  border-radius: 50px;

  padding: 1rem 2rem;

  font-weight: 600;
  text-decoration: none;
  cursor: pointer;

  transition: 0.3s ease;
}

.btn:hover,
.buy-btn:hover {
  background: #1b4332;
  transform: translateY(-3px);
}

/* ===== PRODUCTS ===== */

.products {
  padding: 6rem 8%;
}

.section-title {
  text-align: center;
  font-size: 2.7rem;
  margin-bottom: 3rem;
  color: #1b4332;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 2rem;
}

.product-card {
  background: white;
  border-radius: 20px;
  overflow: hidden;

  box-shadow: 0 10px 25px rgba(0,0,0,0.08);

  transition: 0.35s ease;
}

.product-card:hover {
  transform: translateY(-10px);
  box-shadow: 0 18px 35px rgba(0,0,0,0.12);
}

.product-card img {
  width: 100%;
  height: 260px;
  object-fit: cover;
}

.product-info {
  padding: 1.5rem;
}

.product-info h3 {
  margin-bottom: 0.5rem;
  font-size: 1.4rem;
}

.product-info p {
  color: #666;
  margin-bottom: 1rem;
}

.price {
  font-size: 1.4rem;
  font-weight: bold;
  color: #2d6a4f;
  margin-bottom: 1rem;
}

.buy-btn {
  width: 100%;
  border-radius: 12px;
}

/* ===== ABOUT ===== */

.about {
  background: #f4f9f4;
  padding: 6rem 8%;
  text-align: center;
}

.about p {
  max-width: 850px;
  margin: auto;
  font-size: 1.1rem;
  color: #555;
}

/* ===== CONTACT ===== */

.contact {
  padding: 6rem 8%;
}

form {
  max-width: 650px;
  margin: auto;
}

input,
textarea {
  width: 100%;

  padding: 1rem;
  margin-bottom: 1rem;

  border: 1px solid #ccc;
  border-radius: 14px;

  font-size: 1rem;
  font-family: inherit;

  transition: 0.3s ease;
}

input:focus,
textarea:focus {
  outline: none;
  border-color: #2d6a4f;
  box-shadow: 0 0 0 4px rgba(45,106,79,0.15);
}

textarea {
  min-height: 160px;
  resize: vertical;
}

/* ===== FOOTER ===== */

footer {
  background: #1b4332;
  color: white;

  text-align: center;
  padding: 2rem;
  margin-top: 4rem;
}

/* ===== ANIMATIONS ===== */

.product-card,
.hero-content,
.about,
.contact {
  animation: fadeUp 0.8s ease;
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ===== MOBILE ===== */

@media (max-width: 768px) {

  nav {
    flex-direction: column;
    gap: 1rem;
  }

  nav ul {
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero {
    min-height: 75vh;
  }

  .hero h1 {
    font-size: 2.7rem;
  }

  .hero p {
    font-size: 1rem;
  }

  .section-title {
    font-size: 2rem;
  }

}
